import socket
import json
import time
import threading
from collections import deque, Counter
from http.server import HTTPServer, BaseHTTPRequestHandler
import numpy as np
import joblib

# ================================================================
# OMINOUS - STEP 3 (live, ML zones)
# Sticky majority vote (hysteresis) + empty-guard + stale-data check.
# No motion gate: the vote alone decides, and switching requires a
# sustained takeover, so brief wrong-prediction bursts can't move
# the dot while you're standing still.
# ================================================================

# Board IPs come from environment variables (see ominous_collect.py)
import os
def _board_ip(name):
    ip = os.environ.get(name)
    if not ip:
        raise SystemExit("Set the " + name + " environment variable to that board's IP address.")
    return ip

RX1_IP = _board_ip("OMINOUS_RX1_IP")
RX2_IP = _board_ip("OMINOUS_RX2_IP")
RX3_IP = _board_ip("OMINOUS_RX3_IP")
ALL_BOARDS  = [RX1_IP, RX2_IP, RX3_IP]
BOARD_NAMES = {RX1_IP: "RX-1", RX2_IP: "RX-2", RX3_IP: "RX-3"}

ROOM_WIDTH  = 13
ROOM_HEIGHT = 13
PAD = 8

BOARD_POSITIONS = {
    RX1_IP: (0, 5.5),    # window
    RX2_IP: (13, 10),    # desk
    RX3_IP: (5.9, 0),    # dresser
}

ZONE_POSITIONS = {
    "dresser": (5.9, 0),
    "window":  (0, 5.5),
    "desk":    (13, 10),
    "center":  (ROOM_WIDTH / 2, ROOM_HEIGHT / 2),
}

MODEL_FILE      = "ominous_model.joblib"
INFERENCE_HZ    = 5      # predictions per second
SMOOTH_WINDOW   = 8      # vote looks at the last 8 predictions (~1.6s @ 5Hz)
SWITCH_FRACTION = 0.7    # a new zone needs >= 70% of the window (6 of 8) to take over
EMPTY_FRACTION  = 0.9    # 'empty' needs ~unanimity (8 of 8) before the dot hides
STALE_SECONDS   = 2.0    # ignore a board if its last packet is older than this
PING_PERIOD     = 0.05   # one full ping cycle (~20 pings/sec to each board)

# --- load the trained model ---
_m      = joblib.load(MODEL_FILE)
CLF     = _m["clf"]
SCALER  = _m["scaler"]
LENGTHS = _m["lengths"]
ZONES   = _m["zones"]

# --- shared state ---
latest       = {ip: None for ip in ALL_BOARDS}
last_seen    = {ip: 0 for ip in ALL_BOARDS}
recent_preds = deque(maxlen=SMOOTH_WINDOW)
state = {
    "zone": "empty", "raw": "--", "conf": 0.0,
    "x": ROOM_WIDTH / 2, "y": ROOM_HEIGHT / 2,
    "present": False, "status": "waiting",
}

def amps_from_packet(data):
    out = []
    i = 0
    while i < len(data) - 1:
        im = data[i]; re = data[i + 1]
        if im > 127: im -= 256
        if re > 127: re -= 256
        out.append((re * re + im * im) ** 0.5)
        i += 2
    return out

def fix(v, n):
    v = list(v[:n])
    if len(v) < n:
        v = v + [0.0] * (n - len(v))
    return v

def build_features(vecs):
    f = (fix(vecs[RX1_IP], LENGTHS[0]) +
         fix(vecs[RX2_IP], LENGTHS[1]) +
         fix(vecs[RX3_IP], LENGTHS[2]))
    return np.array([f], dtype=float)

def decide_zone(current):
    """Sticky vote; 'empty' needs near-unanimity so the dot doesn't vanish."""
    if not recent_preds:
        return current
    counts = Counter(recent_preds)
    top_zone, top_count = counts.most_common(1)[0]
    n = len(recent_preds)

    # entering 'empty' (hiding the dot) needs near-unanimous agreement
    if top_zone == "empty" and current != "empty":
        if top_count >= EMPTY_FRACTION * n:
            return "empty"
        # otherwise consider the best NON-empty zone
        non_empty = [(z, c) for z, c in counts.most_common() if z != "empty"]
        if non_empty:
            z, c = non_empty[0]
            if z != current and c >= SWITCH_FRACTION * (n - counts.get("empty", 0)):
                return z
        return current

    if top_zone == current:
        return current
    if top_count >= SWITCH_FRACTION * n:
        return top_zone
    return current

# ----------------------- threads -----------------------
def auto_ping():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    gap = PING_PERIOD / len(ALL_BOARDS)
    while True:
        for ip in ALL_BOARDS:
            try: s.sendto(b"x", (ip, 9))
            except Exception: pass
            time.sleep(gap)

def listen():
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.bind(('0.0.0.0', 5555))
    seen = set()
    while True:
        data, addr = sock.recvfrom(4096)
        ip = addr[0]
        if ip in ALL_BOARDS:
            if ip not in seen:
                seen.add(ip)
                print("Connected: " + BOARD_NAMES[ip] + " (" + ip + ")")
            a = amps_from_packet(data)
            if a:
                latest[ip] = a
                last_seen[ip] = time.time()
        elif ip not in seen:
            seen.add(ip)
            print("Unknown sender " + ip + " (ignored)")

def infer_loop():
    period = 1.0 / INFERENCE_HZ
    ticks = 0
    while True:
        time.sleep(period)

        # wait until every board has sent at least one packet
        if any(latest[ip] is None for ip in ALL_BOARDS):
            state["status"] = "waiting for boards"
            continue

        # don't classify on stale CSI
        now = time.time()
        if any(now - last_seen[ip] > STALE_SECONDS for ip in ALL_BOARDS):
            state["status"] = "waiting for boards"
            continue

        try:
            X = SCALER.transform(build_features(latest))
            zone = CLF.predict(X)[0]
            conf = float(np.max(CLF.predict_proba(X)[0]))
        except Exception:
            state["status"] = "infer error"
            continue

        recent_preds.append(zone)
        sm = decide_zone(state["zone"])

        state["raw"], state["conf"], state["zone"] = zone, conf, sm
        if sm == "empty":
            state["present"] = False
            state["status"]  = "no one detected"
        else:
            state["present"] = True
            state["status"]  = "tracking: " + sm
            state["x"], state["y"] = ZONE_POSITIONS.get(
                sm, (ROOM_WIDTH / 2, ROOM_HEIGHT / 2))

        ticks += 1
        if ticks % INFERENCE_HZ == 0:   # ~once per second
            print("raw=%-8s zone=%-8s conf=%3d%%"
                  % (zone, sm, int(conf * 100)))

# ----------------------- web map -----------------------
def build_board_html():
    parts = []
    for ip in ALL_BOARDS:
        bx, by = BOARD_POSITIONS[ip]
        left = PAD + (bx / ROOM_WIDTH)  * (100 - 2 * PAD)
        top  = PAD + (by / ROOM_HEIGHT) * (100 - 2 * PAD)
        parts.append(
            '<div class="board" style="left:{l:.1f}%;top:{t:.1f}%"></div>'
            '<div class="board-label" style="left:{l:.1f}%;top:{t:.1f}%">{n}</div>'
            .format(l=left, t=top, n=BOARD_NAMES[ip]))
    return "\n        ".join(parts)

